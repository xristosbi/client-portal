# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (never NEXT_PUBLIC_) — used for creating client accounts
# from the admin panel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — welcome emails (server-side only)
RESEND_API_KEY=your-resend-api-key

# Public URL of the deployed portal (no trailing slash) — used for the
# login link inside emails.
NEXT_PUBLIC_SITE_URL=https://your-portal-domain.com

# --- Reserved for later phases (do not fill in yet) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
